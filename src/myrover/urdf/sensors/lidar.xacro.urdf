<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="base_sensor.xacro.urdf" />

  <!-- Lidar blueprint -->
  <xacro:macro name="lidar" params="prefix parent_link topic *origin">
    
    <!-- Base blueprint -->
    <xacro:sensor_base prefix="${prefix}" parent_link="${parent_link}" size="0.05 0.05 0.05" color="blue">
      <xacro:insert_block name="origin" />
    </xacro:sensor_base>

    <!-- Gazebo Integration -->
    <gazebo reference="${prefix}_link">
        <sensor name='${prefix}_sensor' type='gpu_lidar'>
            <pose relative_to='${prefix}_link'>0 0 0 0 0 0</pose>
            <topic>${topic}</topic>
            <update_rate>20</update_rate>
            <gz_frame_id>${prefix}_link</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>450</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.141592</min_angle>
                        <max_angle>3.141592</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>32</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.436332</min_angle>
                        <max_angle>0.08726</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.2</min>
                    <max>90.0</max>
                    <resolution>0.02</resolution>
                </range>
            </lidar>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

  </xacro:macro>

</robot>
